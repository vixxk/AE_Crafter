/**
 * AE-Crafter Layout Engine v5.0 — Real Civil Engineer Grade
 *
 * Architectural rules enforced:
 *  1. Bathrooms sit BESIDE their bedroom (side-by-side), not stacked above/below.
 *  2. Kitchen is adjacent to dining, near the living area — NOT near bedrooms.
 *  3. Living room is at the entrance, spanning the full width.
 *  4. Corridor acts as a central spine connecting private and public zones.
 *  5. Zero overlaps, zero gaps, all walls shared.
 *
 * Layout (South entrance, 3BHK example):
 *
 *  ┌──────────┬──────┬────────┬────────────┐
 *  │          │ Bath │        │            │
 *  │ Bedroom1 │  1   │ Corr.  │  Bedroom2  │  ← Private zone (back)
 *  │          │      │ Stair  │            │
 *  ├──────────┴──────┤        ├─────┬──────┤
 *  │                 │        │Bath │Bed3  │  ← Private zone
 *  │   Kitchen       │        │ 2   │      │
 *  ├─────────────────┴────────┴─────┴──────┤
 *  │            LIVING ROOM                 │  ← Public zone (entrance)
 *  └───────────────────────────────────────-┘
 */

const ROOM_TYPES = {
  BEDROOM: 'bedroom', LIVING_ROOM: 'living room', KITCHEN: 'kitchen',
  BATHROOM: 'bathroom', DINING: 'dining area', STUDY: 'study',
  GUEST_ROOM: 'guest room', BALCONY: 'balcony', GARAGE: 'garage',
  PUJA_ROOM: 'puja room', STAIRCASE: 'staircase', CORRIDOR: 'corridor', PARKING: 'parking',
};

const snap = (v, step = 0.5) => Math.round(v / step) * step;

function generateLayout(input) {
  const {
    plot, rooms: inputRooms,
    setbacks = { top: 3, bottom: 3, left: 3, right: 3 },
    orientation = 'North', requirements = {},
  } = input;

  const { width: plotW, height: plotH } = plot;
  const sb = { ...{ top: 3, bottom: 3, left: 3, right: 3 }, ...setbacks };

  let bx = sb.left, by = sb.top;
  let bw = plotW - sb.left - sb.right;
  let bh = plotH - sb.top - sb.bottom;
  if (bw < 10 || bh < 10) throw new Error('Building area too small after setbacks.');

  // Optionally shrink building envelope if user requested much smaller rooms
  // This prevents extreme stretching like 54x12 living rooms on huge plots
  const totalReqArea = inputRooms.reduce((sum, r) => sum + ((r.width||10) * (r.height||10)), 0);
  const maxAllowedArea = bw * bh;

  // Add 15% overhead for corridors/walls
  if (totalReqArea * 1.15 < maxAllowedArea) {
    // We can shrink the building proportionally!
    const shrinkRatio = Math.sqrt((totalReqArea * 1.15) / maxAllowedArea);
    
    // Calculate new bw/bh, don't fall below minimum plausible house sizes (e.g. 20x20)
    const newBw = snap(Math.max(bw * shrinkRatio, 20));
    const newBh = snap(Math.max(bh * shrinkRatio, 20));

    // Center the shrunken building envelope on the plot
    bx = sb.left + snap((bw - newBw) / 2);
    by = sb.top + snap((bh - newBh) / 2);
    
    bw = newBw;
    bh = newBh;
  }

  const entranceDir = (requirements.entranceDirection || orientation || 'South').toLowerCase();
  const wantStaircase = requirements.staircasePosition && requirements.staircasePosition !== 'none';
  const wantCorridor = requirements.hasCorridor !== undefined ? requirements.hasCorridor : false;
  const wantParking = requirements.hasParking || false;
  const hasCenterSpine = wantCorridor || wantStaircase;

  // ─── Categorize Rooms ─────────────────────────────────────────────
  const roomDefs = inputRooms
    .filter(r => !['staircase', 'corridor', 'parking'].includes((r.type || '').toLowerCase()))
    .map((room, i) => ({
      id: room.id || `room-${i}`,
      type: (room.type || 'bedroom').toLowerCase(),
      reqW: Math.max(room.width || 10, 5),
      reqH: Math.max(room.height || 10, 5),
      wallHeight: room.wallHeight || 10,
    }));

  const bedrooms = roomDefs.filter(r => ['bedroom', 'guest room'].includes(r.type));
  const bathrooms = roomDefs.filter(r => r.type === 'bathroom');
  const kitchens = roomDefs.filter(r => r.type === 'kitchen');
  const livingRooms = roomDefs.filter(r => r.type === 'living room');
  const diningRooms = roomDefs.filter(r => r.type === 'dining area');
  const otherRooms = roomDefs.filter(r =>
    ['study', 'puja room', 'balcony', 'garage'].includes(r.type));

  // Pair bathrooms with bedrooms (ensuite)
  const bedroomPairs = [];
  const usedBaths = new Set();
  for (const bed of bedrooms) {
    let bath = null;
    for (const b of bathrooms) {
      if (!usedBaths.has(b.id)) { bath = b; usedBaths.add(b.id); break; }
    }
    bedroomPairs.push({ bed, bath });
  }
  const unpairedBaths = bathrooms.filter(b => !usedBaths.has(b.id));

  // ─── Grid Dimensions ─────────────────────────────────────────────
  const spineW = hasCenterSpine ? snap(Math.max(5, Math.min(bw * 0.14, 7))) : 0;
  const isNarrow = bw <= 24; // Too small for 3 columns

  let leftColW, rightColW, spineX, rightColX;
  if (isNarrow) {
    // Narrow plot: single large column for rooms, spine on the right
    leftColW = bw - spineW;
    rightColW = 0;
    spineX = bx + leftColW;
    rightColX = spineX + spineW;
  } else {
    // Wide plot: spine in the middle
    leftColW = snap((bw - spineW) / 2);
    rightColW = bw - leftColW - spineW;
    spineX = bx + leftColW;
    rightColX = spineX + spineW;
  }

  // Living room at entry side (full width)
  const hasLiving = livingRooms.length > 0;
  const totalLivingReqH = hasLiving ? livingRooms.reduce((s, r)=> s+r.reqH, 0) : 0;
  // If user requested 10x14, we try to honor the proportional height, else use default ratio
  const tempLivingH = hasLiving ? Math.max(bh * 0.22, 9) : 0;
  const livingH = hasLiving ? snap(Math.max(tempLivingH, Math.min(totalLivingReqH, bh*0.4))) : 0;
  const mainH = bh - livingH;

  // Utility row (kitchen, dining, puja, extra baths)
  const utilityItems = [...kitchens, ...diningRooms, ...otherRooms, ...unpairedBaths];
  const hasUtility = utilityItems.length > 0;
  const utilityRowH = hasUtility ? snap(mainH * 0.40) : 0;
  const privateRowH = mainH - utilityRowH;

  const placedRooms = [];

  // ─── Infrastructure ───────────────────────────────────────────────
  if (hasCenterSpine) {
    if (wantCorridor) {
      const corrH = wantStaircase ? snap(mainH * 0.5) : mainH;
      placedRooms.push({
        id: 'corridor-1', type: 'corridor',
        x: spineX, y: by, width: spineW, height: corrH, wallHeight: 10,
      });
    }
    if (wantStaircase) {
      const stairY = wantCorridor ? by + snap(mainH * 0.5) : by;
      const stairH = wantCorridor ? mainH - snap(mainH * 0.5) : mainH;
      placedRooms.push({
        id: 'staircase-1', type: 'staircase',
        x: spineX, y: stairY, width: spineW, height: stairH, wallHeight: 10,
      });
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  // PRIVATE ZONE — Bedrooms with SIDE-ATTACHED bathrooms
  // ═══════════════════════════════════════════════════════════════════
  const leftPairs = [], rightPairs = [];
  for (let i = 0; i < bedroomPairs.length; i++) {
    if (isNarrow || i % 2 === 0) leftPairs.push(bedroomPairs[i]);
    else rightPairs.push(bedroomPairs[i]);
  }

  function packBedroomColumn(pairs, colX, colW, colY, colH, isLeft) {
    if (pairs.length === 0) return;
    const totalReqH = pairs.reduce((sum, p) => sum + p.bed.reqH, 0);
    let cursor = colY;

    for (let i = 0; i < pairs.length; i++) {
      const { bed, bath } = pairs[i];
      const isLast = i === pairs.length - 1;
      const proportionalH = colH * (bed.reqH / totalReqH);
      const h = isLast ? snap(colY + colH - cursor) : snap(Math.max(proportionalH, 5));

      if (bath) {
        // Bathroom logic: attempt to use reqW if possible, else 30%
        const estBathW = Math.max(colW * 0.28, bath.reqW || 5);
        const bathW = snap(Math.min(Math.max(estBathW, 4.5), colW - 6)); // ensure bed keeps at least 6ft
        const bedW = colW - bathW;

        if (isLeft) {
          // Bathroom on the left (exterior), Bedroom on the right (spine)
          placedRooms.push({ id: bath.id, type: bath.type, x: colX, y: cursor, width: bathW, height: h, wallHeight: bath.wallHeight });
          placedRooms.push({ id: bed.id, type: bed.type, x: snap(colX + bathW), y: cursor, width: bedW, height: h, wallHeight: bed.wallHeight });
        } else {
          // Bedroom on the left (spine), Bathroom on the right (exterior)
          placedRooms.push({ id: bed.id, type: bed.type, x: colX, y: cursor, width: bedW, height: h, wallHeight: bed.wallHeight });
          placedRooms.push({ id: bath.id, type: bath.type, x: snap(colX + bedW), y: cursor, width: bathW, height: h, wallHeight: bath.wallHeight });
        }
      } else {
        placedRooms.push({ id: bed.id, type: bed.type, x: colX, y: cursor, width: colW, height: h, wallHeight: bed.wallHeight });
      }
      cursor = snap(cursor + h);
    }
  }

  // If narrow, leftPairs takes the entire width (leftColW = bw-spine), rightPairs is empty
  packBedroomColumn(leftPairs, bx, leftColW, by, privateRowH, true);
  packBedroomColumn(rightPairs, rightColX, rightColW, by, privateRowH, false);

  // ═══════════════════════════════════════════════════════════════════
  // UTILITY ZONE — Kitchen, Dining, Puja, extra bathrooms
  // ═══════════════════════════════════════════════════════════════════
  if (hasUtility && utilityRowH > 0) {
    const utilY = by + privateRowH;
    const leftUtil = [], rightUtil = [];
    for (let i = 0; i < utilityItems.length; i++) {
      if (isNarrow || i % 2 === 0) leftUtil.push(utilityItems[i]);
      else rightUtil.push(utilityItems[i]);
    }

    function packStack(rooms, colX, colW, colY, colH) {
      if (rooms.length === 0) return;
      const totalReqH = rooms.reduce((s, r)=> s+r.reqH, 0);
      let cursor = colY;
      for (let i = 0; i < rooms.length; i++) {
        const room = rooms[i];
        const isLast = i === rooms.length - 1;
        const h = isLast ? snap(colY + colH - cursor) : snap(Math.max((room.reqH / totalReqH) * colH, 5));
        placedRooms.push({
          id: room.id, type: room.type,
          x: colX, y: cursor, width: colW, height: h,
          wallHeight: room.wallHeight,
        });
        cursor = snap(cursor + h);
      }
    }

    packStack(leftUtil, bx, leftColW, utilY, utilityRowH);
    packStack(rightUtil, rightColX, rightColW, utilY, utilityRowH);
  }

  // ═══════════════════════════════════════════════════════════════════
  // PUBLIC ZONE — Living room at entrance (full building width)
  // ═══════════════════════════════════════════════════════════════════
  if (hasLiving) {
    const livingY = by + mainH;
    placedRooms.push({
      id: livingRooms[0].id, type: livingRooms[0].type,
      x: bx, y: livingY, width: bw, height: livingH,
      wallHeight: livingRooms[0].wallHeight,
    });
  }

  // Fallback: rooms that didn't get placed (edge case)
  const placedIds = new Set(placedRooms.map(r => r.id));
  const unplaced = roomDefs.filter(r => !placedIds.has(r.id));
  if (unplaced.length > 0) {
    const leftUP = [], rightUP = [];
    unplaced.forEach((r, i) => (i % 2 === 0 ? leftUP : rightUP).push(r));
    function packFallback(rooms, colX, colW, colY, colH) {
      if (rooms.length === 0) return;
      const rowH = snap(colH / rooms.length);
      let cursor = colY;
      rooms.forEach((room, idx) => {
        const isLast = idx === rooms.length - 1;
        const h = isLast ? snap(colY + colH - cursor) : rowH;
        placedRooms.push({
          id: room.id, type: room.type,
          x: colX, y: cursor, width: colW, height: h, wallHeight: room.wallHeight,
        });
        cursor = snap(cursor + h);
      });
    }
    packFallback(leftUP, bx, leftColW, by, bh);
    packFallback(rightUP, rightColX, rightColW, by, bh);
  }

  // Parking
  if (wantParking) {
    placedRooms.push({
      id: 'parking-1', type: 'parking',
      x: bx, y: by + bh, width: bw, height: snap(Math.max(8, bh * 0.15)), wallHeight: 0,
    });
  }

  // ═══════════════════════════════════════════════════════════════════
  // OVERLAP SAFETY
  // ═══════════════════════════════════════════════════════════════════
  for (let i = 0; i < placedRooms.length; i++) {
    for (let j = i + 1; j < placedRooms.length; j++) {
      const a = placedRooms[i], b = placedRooms[j];
      if (a.x < b.x + b.width && a.x + a.width > b.x &&
          a.y < b.y + b.height && a.y + a.height > b.y) {
        console.warn(`⚠ Overlap: ${a.type}(${a.id}) vs ${b.type}(${b.id})`);
        b.y = snap(a.y + a.height);
        b.height = snap(Math.max(5, (by + bh) - b.y));
      }
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  // COMPONENTS: DOORS, WINDOWS, VENTILATORS
  // ═══════════════════════════════════════════════════════════════════
  // Rule: Each habitable room gets EXACTLY 1 door. Plus 1 main entrance.
  // Bathrooms → door to their bedroom (ensuite)
  // Bedrooms/Kitchen/Dining → door to corridor or living room
  // ═══════════════════════════════════════════════════════════════════
  const components = [];
  const parseAuto = (val, autoVal) => {
    if (val === 'auto' || val === '' || val == null) return autoVal;
    const n = Number(val); return isNaN(n) ? autoVal : n;
  };

  // Count habitable rooms (rooms that need doors)
  const habitable = placedRooms.filter(r => !['corridor', 'staircase', 'parking'].includes(r.type));
  const numDoors = parseAuto(requirements.numDoors, habitable.length);
  const numWindows = parseAuto(requirements.numWindows, habitable.length);
  const numVentilators = parseAuto(requirements.numVentilators,
    placedRooms.filter(r => r.type === 'bathroom' || r.type === 'kitchen').length);

  // Build shared walls database
  const allWalls = [];
  for (const room of placedRooms) {
    allWalls.push(
      { room: room.id, x1: room.x, y1: room.y, x2: room.x + room.width, y2: room.y },
      { room: room.id, x1: room.x, y1: room.y + room.height, x2: room.x + room.width, y2: room.y + room.height },
      { room: room.id, x1: room.x, y1: room.y, x2: room.x, y2: room.y + room.height },
      { room: room.id, x1: room.x + room.width, y1: room.y, x2: room.x + room.width, y2: room.y + room.height },
    );
  }

  function findWallOverlap(w1, w2) {
    const isH1 = Math.abs(w1.y1 - w1.y2) < 0.1, isH2 = Math.abs(w2.y1 - w2.y2) < 0.1;
    if (isH1 && isH2 && Math.abs(w1.y1 - w2.y1) < 1) {
      const s = Math.max(Math.min(w1.x1, w1.x2), Math.min(w2.x1, w2.x2));
      const e = Math.min(Math.max(w1.x1, w1.x2), Math.max(w2.x1, w2.x2));
      if (e - s > 2) return { isH: true, start: s, end: e, y: w1.y1 };
    }
    if (!isH1 && !isH2 && Math.abs(w1.x1 - w2.x1) < 1) {
      const s = Math.max(Math.min(w1.y1, w1.y2), Math.min(w2.y1, w2.y2));
      const e = Math.min(Math.max(w1.y1, w1.y2), Math.max(w2.y1, w2.y2));
      if (e - s > 2) return { isH: false, start: s, end: e, x: w1.x1 };
    }
    return null;
  }

  const sharedWalls = [];
  const seen = new Set();
  for (let i = 0; i < allWalls.length; i++) {
    for (let j = i + 1; j < allWalls.length; j++) {
      if (allWalls[i].room !== allWalls[j].room) {
        const key = [allWalls[i].room, allWalls[j].room].sort().join('|');
        if (!seen.has(key)) {
          const ov = findWallOverlap(allWalls[i], allWalls[j]);
          if (ov) { sharedWalls.push({ ...ov, r1: allWalls[i].room, r2: allWalls[j].room }); seen.add(key); }
        }
      }
    }
  }

  // Score walls for door priority
  const rMap = new Map(placedRooms.map(r => [r.id, r]));
  const doorScore = (t1, t2) => {
    // Ensuite: bedroom ↔ bathroom (highest priority)
    if ((['bedroom', 'guest room'].includes(t1) && t2 === 'bathroom') ||
        (['bedroom', 'guest room'].includes(t2) && t1 === 'bathroom')) return 12;

    // Connect to circulation spaces
    const c1 = ['corridor', 'living room', 'dining area'].includes(t1);
    const c2 = ['corridor', 'living room', 'dining area'].includes(t2);
    if (c1 && c2) return 10;
    if (c1 || c2) return 8;

    if (t1 === 'parking' || t2 === 'parking') return -10;
    if (t1 === 'staircase' || t2 === 'staircase') return -2; // Last resort

    // Prevent kitchen/bathroom opening directly into a bedroom unless ensuite (already handled)
    if ((t1 === 'kitchen' && ['bedroom', 'guest room', 'bathroom'].includes(t2)) ||
        (t2 === 'kitchen' && ['bedroom', 'guest room', 'bathroom'].includes(t1))) return -5;

    return 1;
  };
  sharedWalls.forEach(sw => { sw.score = doorScore(rMap.get(sw.r1).type, rMap.get(sw.r2).type); });
  sharedWalls.sort((a, b) => b.score - a.score);

  // ─── STRICT MEANINGFUL DOOR PLACEMENT ───────────────────────────────
  const placedDoors = new Set();
  let dc = 0;

  function placeDoor(sw) {
    const key = sw.r1 + '|' + sw.r2;
    if (placedDoors.has(key) || dc >= numDoors) return;
    placedDoors.add(key);

    const pos = snap(sw.start + (sw.end - sw.start) * 0.3);
    if (sw.isH) components.push({ type: 'door', x: pos, y: sw.y, width: 3, orientation: 'horizontal', label: 'D' });
    else components.push({ type: 'door', x: sw.x, y: pos, width: 3, orientation: 'vertical', label: 'D' });
    dc++;
  }

  // Pass 1: Ensuite doors for Bathrooms
  const ensuites = sharedWalls.filter(sw => sw.score === 12);
  for (const sw of ensuites) placeDoor(sw);

  // Pass 2: Main doors for Bedrooms, Kitchen, Dining, etc.
  const mainRooms = placedRooms.filter(r => 
    !['corridor', 'staircase', 'parking', 'bathroom'].includes(r.type)
  );

  for (const room of mainRooms) {
    // Find highest scored wall connecting to something OTHER than a bathroom
    const candidates = sharedWalls.filter(sw =>
      (sw.r1 === room.id || sw.r2 === room.id) &&
      rMap.get(sw.r1).type !== 'bathroom' && rMap.get(sw.r2).type !== 'bathroom'
    );
    if (candidates.length > 0) {
      placeDoor(candidates[0]);
    }
  }

  // Pass 3: Public bathrooms (any bathroom without an ensuite door)
  const allBaths = placedRooms.filter(r => r.type === 'bathroom');
  for (const bath of allBaths) {
    let hasDoor = false;
    for (const key of placedDoors) {
      if (key.includes(bath.id)) { hasDoor = true; break; }
    }
    if (!hasDoor) {
      const candidates = sharedWalls.filter(sw =>
        (sw.r1 === bath.id || sw.r2 === bath.id) &&
        rMap.get(sw.r1).type !== 'staircase' && rMap.get(sw.r2).type !== 'staircase'
      );
      if (candidates.length > 0) placeDoor(candidates[0]);
    }
  }

  // ─── Windows: 1 per room on an exterior wall ─────────────────────
  let wc = 0;
  const br = bx + bw, bb = by + bh;
  for (const room of placedRooms) {
    if (wc >= numWindows || ['corridor', 'staircase', 'parking'].includes(room.type)) continue;
    const t = 0.5;
    // Each room gets at most 1 window — pick the best exterior wall
    if (Math.abs(room.x - bx) < t) {
      components.push({ type: 'window', x: room.x, y: snap(room.y + room.height * 0.4), width: 3.5, orientation: 'vertical', label: 'W' }); wc++;
    } else if (Math.abs(room.x + room.width - br) < t) {
      components.push({ type: 'window', x: room.x + room.width, y: snap(room.y + room.height * 0.4), width: 3.5, orientation: 'vertical', label: 'W' }); wc++;
    } else if (Math.abs(room.y - by) < t) {
      components.push({ type: 'window', x: snap(room.x + room.width * 0.35), y: room.y, width: 3.5, orientation: 'horizontal', label: 'W' }); wc++;
    } else if (Math.abs(room.y + room.height - bb) < t) {
      components.push({ type: 'window', x: snap(room.x + room.width * 0.35), y: room.y + room.height, width: 3.5, orientation: 'horizontal', label: 'W' }); wc++;
    }
  }

  // Ventilators: 1 per bathroom/kitchen on an exterior wall
  let vc = 0;
  for (const room of placedRooms) {
    if (vc >= numVentilators || (room.type !== 'bathroom' && room.type !== 'kitchen')) continue;
    if (Math.abs(room.x - bx) < 0.5) { components.push({ type: 'ventilator', x: room.x, y: snap(room.y + room.height * 0.3), width: 2, orientation: 'vertical', label: 'V' }); vc++; }
    else if (Math.abs(room.x + room.width - br) < 0.5) { components.push({ type: 'ventilator', x: room.x + room.width, y: snap(room.y + room.height * 0.3), width: 2, orientation: 'vertical', label: 'V' }); vc++; }
    else if (Math.abs(room.y + room.height - bb) < 0.5) { components.push({ type: 'ventilator', x: snap(room.x + room.width * 0.5), y: room.y + room.height, width: 2, orientation: 'horizontal', label: 'V' }); vc++; }
  }

  // Entry point
  let entry = null;
  switch (entranceDir) {
    case 'south': entry = { x: snap(bx + bw / 2), y: by + bh, direction: 'South' }; break;
    case 'north': entry = { x: snap(bx + bw / 2), y: by, direction: 'North' }; break;
    case 'east':  entry = { x: bx + bw, y: snap(by + bh / 2), direction: 'East' }; break;
    case 'west':  entry = { x: bx, y: snap(by + bh / 2), direction: 'West' }; break;
    default:      entry = { x: snap(bx + bw / 2), y: by + bh, direction: 'South' };
  }
  if (entry) {
    if (entry.direction === 'South' || entry.direction === 'North')
      components.push({ type: 'door', x: snap(entry.x - 2.25), y: entry.y, width: 4.5, orientation: 'horizontal', label: 'D1' });
    else
      components.push({ type: 'door', x: entry.x, y: snap(entry.y - 2.25), width: 4.5, orientation: 'vertical', label: 'D1' });
  }

  return {
    plot: { width: plotW, height: plotH, setbacks: sb, orientation: orientation || 'North' },
    rooms: placedRooms, components, entry,
    walls: generateWallSegments(placedRooms),
  };
}

function generateWallSegments(rooms) {
  const segs = [];
  for (const r of rooms) {
    segs.push(
      { roomId: r.id, x1: r.x, y1: r.y, x2: r.x + r.width, y2: r.y },
      { roomId: r.id, x1: r.x + r.width, y1: r.y, x2: r.x + r.width, y2: r.y + r.height },
      { roomId: r.id, x1: r.x + r.width, y1: r.y + r.height, x2: r.x, y2: r.y + r.height },
      { roomId: r.id, x1: r.x, y1: r.y + r.height, x2: r.x, y2: r.y },
    );
  }
  return segs;
}

module.exports = { generateLayout, ROOM_TYPES };
